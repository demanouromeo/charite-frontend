# Production reference values for charite.dmsacad.com.
#
# NOTE: unlike a Vite app, Angular's build does NOT read this file at build
# time — it reads src/environments/environment.ts directly (the default
# "production" build configuration in angular.json has no fileReplacements
# entry, so environment.ts IS the production file). This .env.production
# exists only as a human-readable record of the intended production config,
# kept in sync with environment.ts by hand. If you change one, change both.

APP_NAME="Groupe Scolaire Bilingue La Charité"
API_URL=https://dmsacad.com/charite_backend/api
SITE_URL=https://charite.dmsacad.com
